#!/bin/bash
### 安装完成后调用：架构适配 + 写入初始设置
### wizard/install 里的字段会以同名环境变量传入：
###   openp2p_token / openp2p_node / openp2p_sharebandwidth

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -f "${SELF_DIR}/common" ]; then
    # shellcheck source=common
    . "${SELF_DIR}/common"
else
    # shellcheck source=/dev/null
    . "/var/apps/openp2p/cmd/common"
fi

mkdir -p "$DATA_DIR" "$PKGVAR" 2>/dev/null

if ! fix_binary_arch; then
    echo "openp2p 二进制部署失败（当前架构 $(uname -m)），安装中止。详情见 ${LOG_FILE}" \
        2>/dev/null >> "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    exit 1
fi

if ! apply_settings_env; then
    # 半装状态下必须把话说全（qa 第五轮指出）：二进制已经落盘，只有设置没写进去。
    # 不写清楚的话，用户在应用中心看到"运行中"就以为没事了 —— 实测那其实不组网。
    echo "设置写入失败：${SETTINGS} 不可写（请检查存储空间与权限）。注意：程序文件已部署，但设置未写入，应用不会登录组网；修正权限后请在应用中心点『修复』重试。详情见 ${LOG_FILE}" \
        2>/dev/null >> "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    exit 1
fi
log_msg "安装完成：设置已写入 ${SETTINGS}"

exit 0
