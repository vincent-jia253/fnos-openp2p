#!/bin/bash
### 卸载后调用：按用户在 wizard/uninstall 里的选择处理数据
### 用户选择以 openp2p_data_action 传入：keep=保留 / delete=删除

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -f "${SELF_DIR}/common" ]; then
    # shellcheck source=common
    . "${SELF_DIR}/common"
else
    # shellcheck source=/dev/null
    . "/var/apps/openp2p/cmd/common"
fi

action="${openp2p_data_action:-keep}"

# 防御性再停一次：正常情况下 uninstall_init 已经停过，但若它没跑到/失败了，
# 直接删数据目录会在运行中的进程脚下抽掉二进制与配置，留下孤儿进程。
if [ -x "${SELF_DIR}/main" ]; then
    bash "${SELF_DIR}/main" stop >/dev/null 2>&1
fi

case "$action" in
    delete)
        # 不能只删 $DATA_DIR：fnOS 把数据目录建成指向数据卷的**符号链接**，
        # `rm -rf 链接` 只会删掉链接本身，Token 仍留在 /volN/@appshare/<app> 上，
        # 而旧实现还照样打印"已删除配置"—— 那是会骗人的日志（qa 第六轮 B1）。
        real="$(real_data_dir)"
        if remove_data_dir; then
            rm -f "$LOG_FILE" 2>/dev/null
        fi
        # 结论按**实测**说：文件还在就不许说"已删除"
        residual=""
        [ -e "$CONF" ]     && residual="${residual} ${CONF}"
        [ -e "$SETTINGS" ] && residual="${residual} ${SETTINGS}"
        if [ -z "$residual" ]; then
            log_msg "卸载：已按用户选择删除配置与日志（数据目录真实位置 ${real}）"
        else
            log_msg "⚠️ 卸载：已尝试删除配置，但仍有残留：${residual# }，请手动检查 ${real}"
        fi
        ;;
    *)
        log_msg "卸载：已按用户选择保留配置（真实位置 $(real_data_dir)/settings.conf、config.json）"
        ;;
esac

exit 0
