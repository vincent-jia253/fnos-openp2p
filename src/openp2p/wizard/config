[
    {
        "stepTitle": "OpenP2P 设置",
        "items": [
            {
                "type": "tips",
                "helpText": "以下字段<b>留空表示保持当前值不变</b>。保存后若应用正在运行会自动重启使其生效。"
            },
            {
                "type": "password",
                "field": "openp2p_token",
                "label": "Token",
                "initValue": "",
                "rules": [
                    {
                        "pattern": "^[0-9]*$",
                        "message": "Token 是一串数字，请只填写数字"
                    }
                ],
                "helpText": "来自 console.openp2p.cn 个人资料，纯数字"
            },
            {
                "type": "text",
                "field": "openp2p_node",
                "label": "本机节点名",
                "initValue": "",
                "rules": [
                    {
                        "pattern": "^[A-Za-z0-9_-]{0,31}$",
                        "message": "只能包含字母、数字、- 和 _，且不超过 31 位"
                    }
                ],
                "helpText": "1-31 位字母/数字/-/_"
            },
            {
                "type": "text",
                "field": "openp2p_sharebandwidth",
                "label": "共享带宽上限 (Mbps)",
                "initValue": "",
                "rules": [
                    {
                        "pattern": "^(|[0-9]|[1-9][0-9]{1,4}|100000)$",
                        "message": "请输入 0-100000 之间的整数"
                    }
                ],
                "helpText": "0 = 不加入共享网络"
            },
            {
                "type": "text",
                "field": "openp2p_serverhost",
                "label": "服务端地址",
                "initValue": "",
                "rules": [
                    {
                        "pattern": "^[A-Za-z0-9.-]*$",
                        "message": "只能包含字母、数字、- 和 ."
                    }
                ],
                "helpText": "默认 api.openp2p.cn，自建服务端时修改"
            },
            {
                "type": "text",
                "field": "openp2p_serverport",
                "label": "服务端端口",
                "initValue": "",
                "rules": [
                    {
                        "pattern": "^(|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
                        "message": "端口范围 1-65535"
                    }
                ],
                "helpText": "默认 27183"
            },
            {
                "type": "text",
                "field": "openp2p_loglevel",
                "label": "日志级别",
                "initValue": "",
                "rules": [
                    {
                        "pattern": "^[0-3]?$",
                        "message": "请填 0、1、2 或 3"
                    }
                ],
                "helpText": "0 调试 / 1 信息 / 2 警告 / 3 错误"
            },
            {
                "type": "tips",
                "helpText": "更多功能（端口转发 P2PApp 管理、设备列表）请使用 <a href=\"https://console.openp2p.cn\" target=\"_blank\">console.openp2p.cn</a>，或打开本应用界面。"
            }
        ]
    }
]
